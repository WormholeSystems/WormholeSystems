# Build output
/target
**/*.rs.bk

# Downloaded SDE data under data/ (~660 MB, regenerated via the downloader).
# The hand-authored static JSON that augments the SDE lives alongside in
# data/ and IS committed — only these two regenerable paths are ignored.
/data/sde/
/data/sde.zip

# What people upload (map background images). A volume in the container.
/data/uploads/

# Secrets — `.env.example` is committed, real `.env` is not
.env
.env.local

# An install's own compose changes (see docs/deployment.md)
/compose.override.yml
/docker-compose.override.yml

# Database dumps from wsctl and the backup service
/backups/

# macOS
.DS_Store
/node_modules

# Stray ts-rs default output (real export goes to frontend/src/lib/api/types)
/bindings

# Playwright output
test-results/

# Personal dev tooling
/solo.yml
.claude/worktrees/
