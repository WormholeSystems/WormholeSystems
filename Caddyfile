# Single origin: backend paths go to Axum, everything else to SvelteKit.
# WebSocket upgrades pass through reverse_proxy automatically.
#
# The site address comes from WS_DOMAIN, and how it gets a certificate from WS_TLS:
#   acme      Let's Encrypt, for a domain that resolves here with 80 and 443 reachable.
#             Caddy redirects http to https on its own. The default.
#   files     your own, mounted from certs/ (WS_TLS_CERT and WS_TLS_KEY name the files).
#   internal  Caddy's own CA, which browsers warn about; for a private network.
#   off       plain http, for something in front of it that does TLS.
# Without a domain it is plain http on :80, which is what local full-stack testing wants.
# Behind your own proxy (deploy/router-*.yml) it is always plain http on :80.
{
	servers {
		# Whose X-Forwarded-For and -Proto to believe. Only the router overlays set this,
		# to the private ranges your proxy connects from; facing the internet, nobody's
		# (the loopback is this container, which never proxies to itself).
		trusted_proxies static {$WS_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

(app) {
	# Your additions to this site (headers, redirects, a handle of your own), from
	# caddy.d/*.site in the checkout. Kept out of this file so an update never fights them.
	import /etc/caddy/conf.d/*.site

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws/* {
		reverse_proxy api:3000
	}
	handle /auth/* {
		reverse_proxy api:3000
	}
	# Account linking and the endpoint Discord posts interactions to.
	handle /discord/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3001
	}
}

# One per WS_TLS, picked by name at the bottom, so a value that is none of these stops
# Caddy naming the snippet it could not find.
(tls-acme) {
	{$WS_DOMAIN::80} {
		import app
	}
}

(tls-files) {
	{$WS_DOMAIN::80} {
		tls /certs/{$WS_TLS_CERT:fullchain.pem} /certs/{$WS_TLS_KEY:privkey.pem}
		import app
	}
}

(tls-internal) {
	{$WS_DOMAIN::80} {
		tls internal
		import app
	}
}

(tls-off) {
	http://{$WS_DOMAIN::80} {
		import app
	}
}

import tls-{$WS_TLS:acme}

# Whole blocks of your own, from caddy.d/*.caddy: another site on this Caddy, a snippet.
import /etc/caddy/conf.d/*.caddy
