# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.

# Who is running this install. Every request WormholeSystems makes to ESI, zKillboard, EVE Ref and
# EVE Scout carries these in its User-Agent, which is how those services tell operators
# apart and how they reach you if something here misbehaves. CCP asks for it, and an
# anonymous client gets throttled and eventually blocked. Use the in-game name of the
# character who administers this install, and an address you actually read. Quote them:
# dotenv refuses a bare value with a space in it.
WS_CONTACT_NAME="Your Character Name"
WS_CONTACT_EMAIL="you@example.com"

# What docker calls the stack: containers, the network and the volumes are all named after
# it. Without it they would be named after whatever directory the checkout is in.
COMPOSE_PROJECT_NAME=wormholesystems

# Where this runs. `docker compose up -d --build` starts the whole stack either way; these
# decide how it faces the world. Left as they are, Caddy serves plain http on
# http://localhost. Set WS_DOMAIN to a domain that resolves to this machine and Caddy gets a
# certificate for it and serves https on 80/443: that is production.
WS_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443

# Where the API and frontend images come from: GitHub's registry, built for amd64 and
# arm64 from every push to main. WS_VERSION is the tag: `main` follows the branch, a
# release such as 1.2.3 stays put, and sha-<commit> is one exact build.
# WS_IMAGES=pull builds nothing here: `wsctl update` pulls instead of compiling, and
# `build` (or leaving it unset) builds from the checkout.
# WS_IMAGES=pull
# WS_IMAGE_PREFIX=ghcr.io/wormholesystems/wormholesystems
# WS_VERSION=main

# How it is put together. `wsctl setup` asks and fills these in; see docs/deployment.md.
# WS_DATABASE is `bundled` (a Postgres container here) or `external` (yours, at
# WS_DATABASE_URL). WS_PROXY is `caddy` (Caddy here on 80/443 with its own certificate),
# `router` (Caddy here behind your proxy, as a plain-http path router), `network` (your
# proxy in Docker reaches the app itself) or `ports` (your proxy on this machine reaches it
# on loopback ports). Anything other than both bundled needs the matching overlays from
# deploy/ in COMPOSE_FILE, which wsctl writes.
# WS_DATABASE=bundled
# WS_PROXY=caddy
# COMPOSE_FILE=docker-compose.yml:deploy/external-db.yml:deploy/app-network.yml
# WS_PUBLIC_URL=https://map.example.com
# WS_DATABASE_URL=postgres://wormholesystems:password@postgres:5432/wormholesystems
# WS_DATABASE_NETWORK=
# WS_PROXY_NETWORK=wormholesystems
# WS_ROUTER_PORT=8080
# WS_API_PORT=3000
# WS_WEB_PORT=3001
# WS_TRUSTED_PROXIES=private_ranges

# EVE Online SSO application — register at https://developers.eveonline.com/
# The callback is the origin the browser uses plus /auth/callback: http://localhost here,
# https://<WS_DOMAIN> in production. Running the API and vite on the host instead, the app
# lives on the vite origin, so register http://localhost:5173/auth/callback for that.
EVE_CLIENT_ID=your-client-id
EVE_CLIENT_SECRET=your-client-secret
EVE_REDIRECT_URI=http://localhost/auth/callback

# Who may log in: EVE character, corporation and alliance ids, comma separated. A character
# gets in when its own id, its corporation's or its alliance's is listed. Empty lets anyone
# with an EVE account in. Checked at login only, so a session already open is not cut off.
ALLOWED_AFFILIATION_IDS=

# Who may create maps, same format, matched against the character the map is created as.
# Independent of the list above: empty lets everyone who can log in create maps.
MAP_CREATOR_AFFILIATION_IDS=

# A banner above every page, the landing page included, for downtime, a move or anything
# else people should read first. Off while the message is empty. The level is info, warning
# or critical. A closed banner stays closed until any of its text changes; set DISMISSIBLE
# to false for one nobody can close. Quote anything with a space in it. Read when the API
# starts, so restart it after a change.
ANNOUNCEMENT_LEVEL=info
ANNOUNCEMENT_TITLE=
ANNOUNCEMENT_MESSAGE=
ANNOUNCEMENT_LINK_URL=
ANNOUNCEMENT_LINK_LABEL=
ANNOUNCEMENT_DISMISSIBLE=true

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://wormholesystems:wormholesystems@localhost:5432/wormholesystems

# Killmail ingest + threat analysis (polls zKillboard when enabled). Enabling it also fills
# in the last 90 days from EVE Ref's archives on boot, once, for whatever is missing.
# ZKB_LISTEN=1
# KILLMAIL_BACKFILL_DAYS=90

# Where ESI lives. Unset means the real thing. The e2e suite sets it to
# `frontend/e2e/esi-stub.mjs`, which proxies anything it has not been scripted through to
# real ESI, so it is safe in front of a dev stack too: set this (and run `node
# e2e/esi-stub.mjs` from `frontend/`) and the ESI-driven tests will run against a stack you
# started yourself instead of skipping.
# ESI_BASE_URL=http://127.0.0.1:3999

# How often to ask ESI whether Tranquility is up (seconds). Everything that polls ESI is
# gated on the answer, so a shorter interval means a faster recovery after downtime.
# SERVER_STATUS_POLL_SECS=60

# How often to mirror the raidable-skyhook list from ESI (seconds).
# SKYHOOK_POLL_SECS=300

# Discord. All five are needed for the bot half (account linking and slash commands);
# leave them unset and the alerts UI still works with channel webhooks.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5173/discord/callback
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# Only needed to post as the bot (direct messages, bot channels).
# DISCORD_BOT_TOKEN=

# Where uploaded files (map background images) are kept. In the container this is the
# `uploads` volume; only change it when the API runs outside Docker.
# UPLOADS_DIR=data/uploads
